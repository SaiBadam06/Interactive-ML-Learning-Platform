# API Key - get one free at https://build.nvidia.com (Get API Key)
NVIDIA_API_KEY=nvapi-your_key_here

# Flask Configuration
# SECRET_KEY signs the login cookie. Required on Vercel; generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production
FLASK_ENV=development
FLASK_DEBUG=True

# Supabase (login + saved lessons). Project Settings -> API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# Server only. Needed for the admin invite page; never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Comma-separated emails allowed to invite users.
ADMIN_EMAILS=admin@example.com
# Base URL invite/reset links point back to (defaults to the request host).
SITE_URL=https://your-app.vercel.app

# Dummy admin account for local testing. The real password lives in .env
# (gitignored) - never commit a working login to this file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=set_in_dot_env_not_here

# --- Local development only. NEVER set either of these on a deployment. ---
# Run without a login. Required now: missing Supabase config fails closed
# rather than silently publishing every page. Ignored when VERCEL is set.
# AUTH_OPTIONAL=1
# Drop the Secure flag so the session cookie works over plain http locally.
# INSECURE_COOKIES=1
